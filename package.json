{
  "name": "cards",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-app": "tauri dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "update-icons": "python3 scripts/prepare-android-icon.py && python3 scripts/prepare-macos-icon.py && bun tauri icon src-tauri/icon-manifest.json -o src-tauri/icons && cp -f src/assets/icon.icns src-tauri/icons/ && cp -f src-tauri/icons/32x32.png public/favicon.png",
    "patch": "tauri-version patch --no-lock -m \"release v%s\" && git push --follow-tags",
    "minor": "tauri-version minor --no-lock -m \"release v%s\" && git push --follow-tags",
    "major": "tauri-version major --no-lock -m \"release v%s\" && git push --follow-tags"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.30.2",
    "@tiptap/markdown": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tauri-version": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}